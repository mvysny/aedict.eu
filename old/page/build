#!/bin/bash
set -e -o pipefail

function processtemplates() {
for i in _*.vars; do
  . $i
  (
  NAME=${i:1:${#i} - 6}
  SEL=${NAME}_SELECTED
  declare -x $SEL=" class=\"selected\""
  envsubst <_template.html >$NAME.html
  )
done

for i in */_template.html; do
  if [[ ! $i =~ ^\*.* ]]; then
    cd `dirname $i`
    processtemplates
    cd ..
  fi
done

}

processtemplates


PAGE_ROOT=$HOME/temp/stranka/target
rm -rf $PAGE_ROOT
mkdir -p $PAGE_ROOT
cp -r . $PAGE_ROOT/
cd $PAGE_ROOT
find . -iname 'build'|xargs rm
find . -iname 'build_and_upload'|xargs rm
find . -iname '_*'|xargs rm



#chromium-browser "$PAGE_ROOT/index.html"


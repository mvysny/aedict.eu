function bug() {
  echo "<a href=\"http://code.google.com/p/aedict/issues/detail?id=$1\">bug #$1</a>"
}

export TITLE="Privacy Policy"

export CONTENT='''

<div style="padding-top: 46px">
<h2>Privacy Policy</h2>
<p>Aedict3 OCR uses SDCard to store captured images and recognized text. Internet access is only used when backing up/restoring data to/from ownCloud and/or Dropbox.</p>
<p>Aedict3 OCR uses the following permissions:</p>
<ul><li>Read/Write External storage: used when importing images from Gallery</li>
<li>Network: used when backing up/restoring data to/from ownCloud and/or Dropbox</li>
</ul>
</div>

        <div class="clear" style="padding-top: 43px"></div>


'''


